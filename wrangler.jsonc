// Cloudflare Workers Static Assets configuration.
// The preview environment is route-free. Production promotion is a separate
// maintainer gate documented in docs/deployment.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sangrep-site",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "sangrep.com", "custom_domain": true },
    { "pattern": "www.sangrep.com", "custom_domain": true },
  ],
  "env": {
    "preview": {
      "name": "sangrep-site-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
    },
  },
}
